{
  "name": "network-simulator",
  "version": "6.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest run",
    "update-readme": "node scripts/update-readme-badges.cjs",
    "check": "tsc --noEmit && next build && oxlint && vitest run",
    "build:desktop": "node scripts/build-desktop.cjs",
