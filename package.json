{
  "name": "network-simulator",
  "version": "7.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning node_modules/next/dist/bin/next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest run",
    "test:perf": "vitest run src/tests/performance",
    "update-readme": "node scripts/update-readme-badges.cjs",
    "check": "tsc --noEmit && next build && oxlint && vitest run",
    "build:desktop": "node scripts/build-desktop.cjs",
    "build:low-resource": "node scripts/build-low-resource.cjs",
    "tauri": "tauri",
    "build:exe": "tauri build",
    "build:exe-low-resource": "tauri build --config src-tauri/tauri-low-resource.conf.json",
    "clean": "node -e \"['.next','out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "clean:desktop": "node -e \"fs.rmSync('src-tauri/target',{recursive:true,force:true})\"",
    "clean:all": "node -e \"['.next','out','src-tauri/target'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "~2.11.1",
    "@upstash/redis": "^1.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@csstools/css-calc": "^3.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.83.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "nanoid": ">=3.3.18",
    "postcss": "^8.5.26"
  },
  "onlyBuiltDependencies": [
    "core-js",
    "sharp",
    "unrs-resolver"
  ],
  "allowScripts": {
    "core-js@3.50.0": true,
    "unrs-resolver@1.12.2": true
  }
}
