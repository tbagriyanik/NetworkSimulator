{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Network Simulator (Low Resource)",
  "version": "6.8.0",
  "identifier": "com.networksimulator.desktop.lowresource",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:low-resource"
  },
  "app": {
    "windows": [
      {
        "title": "Network Simulator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "transparent": false,
        "decorations": true,
        "webview": {
          "allow_scripts": true,
          "html": false,
          "js": false,
          "http_scheme": true
        },
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*",
      "README.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Network Simulator"
  },
  "plugins": {}
}