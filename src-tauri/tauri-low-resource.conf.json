{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Network Simulator (Low Resource)",
  "version": "7.2.1",
  "identifier": "com.networksimulator.desktop.lowresource",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:low-resource"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Network Simulator",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "transparent": false,
        "decorations": true,
        "visible": true,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-dev-shm-usage --js-flags=--max-old-space-size=2048"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*",
      "README.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Network Simulator"
  }
}
